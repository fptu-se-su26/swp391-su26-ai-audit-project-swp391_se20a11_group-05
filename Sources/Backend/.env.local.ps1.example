# File mẫu — SAO CHÉP thành .env.local.ps1 và điền key thật vào
# File .env.local.ps1 đã được thêm vào .gitignore và KHÔNG được commit lên Git

# Firebase Admin SDK
# Firebase Console → Project Settings → Service accounts → Generate new private key.
# Lưu JSON bên ngoài src/main/resources rồi dùng đường dẫn tuyệt đối tới file đó.
$env:GOOGLE_APPLICATION_CREDENTIALS="C:\path\outside-repository\firebase-service-account.json"
$env:GOOGLE_CLOUD_PROJECT="citysystem-d7e72"

$env:SUPABASE_DB_URL="jdbc:postgresql://<host>.pooler.supabase.com:6543/postgres?prepareThreshold=0"
$env:SUPABASE_DB_USER="postgres.<project-id>"
$env:SUPABASE_DB_PASSWORD="your-supabase-db-password"
$env:SUPABASE_URL="https://<project-id>.supabase.co"
$env:SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
$env:SUPABASE_STORAGE_BUCKET="feedback-images"
$env:GROQ_API_KEYS="your-groq-api-key-1,your-groq-api-key-2"
$env:DEEPSEEK_API_KEY="your-deepseek-api-key"
$env:GEMINI_API_KEYS="your-gemini-api-key"

# Cloudinary Credentials (lấy từ dashboard Cloudinary cá nhân hoặc của nhóm)
$env:CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
$env:CLOUDINARY_API_KEY="your-cloudinary-api-key"
$env:CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
