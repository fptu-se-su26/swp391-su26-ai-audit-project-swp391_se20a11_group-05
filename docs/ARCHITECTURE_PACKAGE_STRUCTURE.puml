@startuml Smart City Backend - Package Structure
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 10
skinparam ranksep 20

' Color scheme
skinparam package {
    BackgroundColor<<modules>> #E3F2FD
    BorderColor<<modules>> #1976D2
    BackgroundColor<<infrastructure>> #FFF3E0
    BorderColor<<infrastructure>> #F57C00
    BackgroundColor<<ai>> #F3E5F5
    BorderColor<<ai>> #7B1FA2
    BackgroundColor<<common>> #E8F5E9
    BorderColor<<common>> #388E3C
}

title Smart City Backend - Complete Package Structure\n(Spring Boot 4.0.6 + Java 21)

package "com.example.smartcity" {
    
    ' ═══════════════════════════════════════════════════════════
    ' MODULES - Business Features (9 modules)
    ' ═══════════════════════════════════════════════════════════
    package "modules" <<modules>> {
        
        package "auth" {
            folder "controller" as auth_ctrl {
                [AuthController.java]
            }
            folder "service" as auth_svc {
                [AuthService.java]
                [MfaService.java]
                [SmsService.java]
                [RefreshTokenService.java]
                [MfaSessionService.java]
                [FirebaseService.java]
            }
            folder "repository" as auth_repo {
                [RefreshTokenRepository.java]
                [SmsVerificationRepository.java]
            }
            folder "entity" as auth_entity {
                [RefreshToken.java]
                [SmsVerification.java]
            }
            folder "payload" as auth_payload {
                [LoginRequest.java]
                [RegisterRequest.java]
                [AuthResponse.java]
                [TokenPairResponse.java]
                [MfaVerificationRequest.java]
            }
        }
        
        package "user" {
            folder "controller" as user_ctrl {
                [UserController.java]
            }
            folder "service" as user_svc {
                [UserService.java]
            }
            folder "repository" as user_repo {
                [UserRepository.java]
            }
            folder "entity" as user_entity {
                [User.java]
                [Role.java (enum)]
            }
            folder "dto" as user_dto {
                [UserDTO.java]
            }
            folder "mapper" as user_mapper {
                [UserMapper.java (MapStruct)]
            }
        }
        
        package "feedback" {
            [controller]
            [service]
            [repository]
            [dto]
            [entity]
            [mapper]
        }
        
        package "notification" {
            [controller]
            [service]
            [repository]
            [dto]
            [entity]
            [mapper]
        }
        
        package "chatbot" {
            [service]
            [repository]
            [entity]
        }
        
        package "weather" {
            [controller]
            [service]
            [dto]
        }
        
        package "file" {
            [FileController.java]
            [FileStorageService.java]
        }
        
        package "analytics" {
            [AnalyticsController.java]
        }
        
        package "core" {
            [Ward.java (entity)]
            [District.java (entity)]
        }
    }
    
    ' ═══════════════════════════════════════════════════════════
    ' AI ORCHESTRATOR - AI System
    ' ═══════════════════════════════════════════════════════════
    package "ai_orchestrator" <<ai>> {
        folder "adapter" {
            [GroqAdapter.java]
            [GeminiAdapter.java]
        }
        folder "pool" {
            [GroqKeyPool.java]
            [GeminiKeyPool.java]
            [ApiKeyRotator.java]
        }
        folder "racing" {
            [LlmRacingService.java]
            [RaceResult.java]
        }
        folder "guardrails" {
            [InputValidator.java]
            [OutputFilter.java]
        }
        folder "router" {
            [LlmRouter.java]
            [RoutingStrategy.java]
        }
        folder "controller" as ai_ctrl {
            [AiAdminController.java]
        }
    }
    
    ' ═══════════════════════════════════════════════════════════
    ' RAG - Retrieval-Augmented Generation
    ' ═══════════════════════════════════════════════════════════
    package "rag" <<ai>> {
        folder "ingestion" {
            [DocumentIndexer.java]
            [EmbeddingService.java]
            [ChunkingService.java]
        }
        folder "retrieval" {
            [VectorRetriever.java]
            [Bm25Retriever.java]
            [RrfFusionService.java]
        }
        folder "generation" {
            [LlmExecutionService.java]
            [PromptBuilder.java]
        }
        folder "selfrag" {
            [SelfRagService.java]
            [RelevanceScorer.java]
        }
        folder "metrics" {
            [TokenCostTracker.java]
            [PerformanceMetrics.java]
        }
    }
    
    ' ═══════════════════════════════════════════════════════════
    ' SECURITY - Security Infrastructure
    ' ═══════════════════════════════════════════════════════════
    package "security" <<infrastructure>> {
        folder "jwt" {
            [JwtTokenProvider.java]
            [JwtAuthenticationFilter.java]
            [JwtAuthEntryPoint.java]
            [TokenBlacklistService.java]
        }
        folder "ratelimit" {
            [AuthRateLimiter.java]
            [RateLimitExceededException.java]
        }
        folder "secrets" {
            [SecurityManager.java]
            [SecretsProvider.java (interface)]
            [KubernetesSecretsProvider.java]
            [DockerSecretsProvider.java]
            [EnvironmentSecretsProvider.java]
        }
        folder "https" {
            [HttpsRedirectFilter.java]
        }
        [SecurityConfig.java]
        [CustomUserDetailsService.java]
    }
    
    ' ═══════════════════════════════════════════════════════════
    ' COMMON - Shared Code
    ' ═══════════════════════════════════════════════════════════
    package "common" <<common>> {
        folder "base" {
            [BaseEntity.java]
            [BaseRepository.java]
            [BaseService.java]
            [BaseServiceImpl.java]
            [BaseGenericController.java]
            [BaseMapper.java]
        }
        folder "exception" {
            [GlobalExceptionHandler.java]
            [CustomException.java]
            [ResourceNotFoundException.java]
        }
        folder "response" {
            [ApiResponse.java]
        }
        folder "security" as common_sec {
            [AttributeEncryptor.java]
        }
        folder "logging" {
            [MdcLoggingFilter.java]
        }
    }
    
    ' ═══════════════════════════════════════════════════════════
    ' CONFIG - Configuration Beans
    ' ═══════════════════════════════════════════════════════════
    package "config" <<infrastructure>> {
        [CacheConfig.java]
        [WebClientConfig.java]
        [WebSocketConfig.java]
    }
}

' ═══════════════════════════════════════════════════════════
' RELATIONSHIPS
' ═══════════════════════════════════════════════════════════

' Modules depend on Common
auth_ctrl -down-> common
user_ctrl -down-> common
feedback -down-> common
notification -down-> common

' Modules depend on Security
auth_svc -right-> security
user_svc -right-> security

' AI Orchestrator uses Config
ai_orchestrator -down-> config

' RAG uses AI Orchestrator
rag -right-> ai_orchestrator

' Security uses Common
security -down-> common

' Chatbot uses RAG
chatbot -right-> rag

note right of modules
  **9 Business Modules**
  - Layered Architecture
  - Feature-based Design
  - Microservice-ready
end note

note right of ai_orchestrator
  **AI System**
  - Key Pool Management
  - Parallel Racing
  - Circuit Breaker
  - Guardrails
end note

note right of rag
  **Hybrid RAG**
  - Vector Search
  - BM25 Search
  - RRF Fusion
  - Self-RAG
end note

note right of security
  **Security Infrastructure**
  - JWT Authentication
  - Rate Limiting
  - Secrets Management
  - HTTPS Redirect
end note

note right of common
  **Shared Components**
  - Base Classes
  - Exception Handling
  - API Response Format
  - AES-256 Encryption
end note

@enduml
