# Database (existing Supabase PostgreSQL)
SUPABASE_DB_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:6543/postgres?prepareThreshold=0&sslmode=require
SUPABASE_DB_USER=YOUR_SUPABASE_DB_USER
SUPABASE_DB_PASSWORD=CHANGE_ME

# Supabase Storage/API
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
SUPABASE_STORAGE_BUCKET=feedback-images

# Application security
JWT_SECRET=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
ENCRYPTION_SECRET=EXACTLY_32_RANDOM_CHARACTERS
ADMIN_API_TOKEN=GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS
CORS_ALLOWED_ORIGINS=https://danangketnoi.io.vn,https://www.danangketnoi.io.vn,https://swp391-su26-ai-audit-project-swp391-iota.vercel.app
HTTPS_REDIRECT_ENABLED=false
JPA_SHOW_SQL=false

# AI providers (leave blank only if the related feature is disabled)
GROQ_API_KEYS=
GEMINI_API_KEYS=
DEEPSEEK_API_KEY=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email OTP
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true

# SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
