@startuml Smart City Backend - Simplified Architecture
!theme plain
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false

title Smart City Backend - Package Structure Overview

' Color scheme
skinparam package {
    BackgroundColor<<modules>> #E3F2FD
    BorderColor<<modules>> #1976D2
    FontColor<<modules>> #0D47A1
    
    BackgroundColor<<ai>> #F3E5F5
    BorderColor<<ai>> #7B1FA2
    FontColor<<ai>> #4A148C
    
    BackgroundColor<<infra>> #FFF3E0
    BorderColor<<infra>> #F57C00
    FontColor<<infra>> #E65100
    
    BackgroundColor<<common>> #E8F5E9
    BorderColor<<common>> #388E3C
    FontColor<<common>> #1B5E20
}

package "com.example.smartcity" {
    
    package "modules (9 modules)" <<modules>> {
        rectangle "auth\n━━━━━━━━━━━━━━━━━━━━\ncontroller/\nservice/\nrepository/\nentity/\npayload/" as auth
        
        rectangle "user\n━━━━━━━━━━━━━━━━━━━━\ncontroller/\nservice/\nrepository/\nentity/\ndto/\nmapper/" as user
        
        rectangle "feedback\nnotification\nchatbot\nweather\nfile\nanalytics\ncore" as other_modules
    }
    
    package "ai_orchestrator" <<ai>> {
        rectangle "adapter/\npool/\nracing/\nguardrails/\nrouter/\ncontroller/" as ai_orch
    }
    
    package "rag" <<ai>> {
        rectangle "ingestion/\nretrieval/\ngeneration/\nselfrag/\nmetrics/" as rag_pkg
    }
    
    package "security" <<infra>> {
        rectangle "jwt/\nratelimit/\nsecrets/\nhttps/\nSecurityConfig" as sec
    }
    
    package "common" <<common>> {
        rectangle "base/\nexception/\nresponse/\nsecurity/\nlogging/" as common_pkg
    }
    
    package "config" <<infra>> {
        rectangle "CacheConfig\nWebClientConfig\nWebSocketConfig" as config_pkg
    }
}

' Dependencies
auth -down-> common_pkg : extends
user -down-> common_pkg : extends
other_modules -down-> common_pkg : extends

auth -right-> sec : uses
user -right-> sec : uses

ai_orch -down-> config_pkg : uses
rag_pkg -right-> ai_orch : uses
other_modules -right-> rag_pkg : uses

sec -down-> common_pkg : uses

' Legend
legend right
  |= Color |= Layer |
  | <back:#E3F2FD>   </back> | Business Modules (9) |
  | <back:#F3E5F5>   </back> | AI System (2) |
  | <back:#FFF3E0>   </back> | Infrastructure (2) |
  | <back:#E8F5E9>   </back> | Shared Components (1) |
endlegend

note bottom of modules
  **Layered Architecture**
  Controller → Service → Repository
  
  **Feature-based Modular Design**
  Each module = Bounded Context
end note

note bottom of ai_orchestrator
  **AI Orchestration**
  • Key Pool Management
  • Parallel LLM Racing
  • Circuit Breaker Pattern
end note

note bottom of rag
  **Hybrid RAG System**
  • Vector Search (pgvector)
  • BM25 Search (Lucene)
  • RRF Fusion
  • Self-RAG Validation
end note

note bottom of security
  **Security Infrastructure**
  • JWT (HS512, 15min access token)
  • Rate Limiting (Sliding Window)
  • Secrets Management (K8s/Docker/Env)
  • HTTPS Redirect + HSTS
end note

@enduml
